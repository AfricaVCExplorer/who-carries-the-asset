---
// A row of condition cards with small icons (e.g. Figure 9).
interface Item { icon: string; title: string; text: string }
interface Props { number: number; title: string; items: Item[]; captionHtml: string; id: string }
const { number, title, items, captionHtml, id } = Astro.props;
---
<figure class="figure fig-cards reveal" aria-labelledby={`${id}-t`}>
  <p class="ft" id={`${id}-t`}>{title}</p>
  <ul class="cond" role="list">
    {items.map((it) => (
      <li>
        {it.icon === 'bars' && <svg viewBox="0 0 44 36" aria-hidden="true"><rect x="2" y="22" width="6" height="12" fill="#F2766B" stroke="#16132B" stroke-width="1.4"/><rect x="12" y="18" width="6" height="16" fill="#F2766B" stroke="#16132B" stroke-width="1.4"/><rect x="22" y="22" width="6" height="12" fill="#F2766B" stroke="#16132B" stroke-width="1.4"/><rect x="32" y="16" width="6" height="18" fill="#F2766B" stroke="#16132B" stroke-width="1.4"/></svg>}
        {it.icon === 'line' && <svg viewBox="0 0 44 36" aria-hidden="true"><path d="M2 30 L12 20 L20 24 L30 10 L42 6" stroke="#5B21E6" stroke-width="2.4" fill="none" stroke-linecap="round"/><path d="M2 34 L42 34" stroke="#16132B" stroke-width="1.4"/></svg>}
        {it.icon === 'lock' && <svg viewBox="0 0 44 36" aria-hidden="true"><rect x="12" y="16" width="20" height="18" rx="2" fill="#ECE6FD" stroke="#16132B" stroke-width="1.6"/><path d="M16 16 L16 10 C 16 4, 28 4, 28 10 L28 16" fill="none" stroke="#16132B" stroke-width="1.8"/></svg>}
        <strong>{it.title}</strong>
        <span>{it.text}</span>
      </li>
    ))}
  </ul>
  <figcaption class="cap"><b>Figure {number}</b><span set:html={captionHtml} /></figcaption>
</figure>
