---
// Renders converted section blocks (see scripts/web_sections.py).
import RawFigure from './RawFigure.astro';
interface Props { blocks: any[] }
const { blocks } = Astro.props;
---
{blocks.map((b: any) => {
  if (b.type === 'label') return <p class="lb sec-lb">{b.text}</p>;
  if (b.type === 'h') return <h2 id={b.id} class:list={['sec-h', { 'sec-h3': b.level === 3 && b.minor }]}>{b.title}<a class="anchor" href={`#${b.id}`} aria-label="Link to this section">#</a></h2>;
  if (b.type === 'p') return <p class:list={{ 'lead-in': b.lead }} set:html={b.out} />;
  if (b.type === 'list') return <ul class="sec-list">{b.out.map((li: string) => <li set:html={li} />)}</ul>;
  if (b.type === 'quote') return <figure class="pq reveal"><blockquote><p>{b.text}</p></blockquote></figure>;
  if (b.type === 'items') return (
    <div class="sec-items-wrap">
      <ol class="sec-items" role="list">
        {b.items.map((it: any) => (
          <li style={it.accent ? `--acc:${it.accent}` : undefined} class:list={{ 'has-acc': it.accent }}>
            <span class="n" aria-hidden="true">{it.n}</span>
            <div>
              {it.title && (b.hTag === 'h2' ? <h2 class="item-h" set:html={it.titleOut} /> : <h3 set:html={it.titleOut} />)}
              <p set:html={it.out} />
            </div>
          </li>
        ))}
      </ol>
      {b.figure && <p class="cap"><b>Figure {b.figure.number}</b><span set:html={b.figure.out} /></p>}
    </div>
  );
  if (b.type === 'figure') return <RawFigure number={b.number} title={b.title} html={b.html} board={b.board} captionHtml={b.out} alt={b.alt} />;
  if (b.type === 'flow') return <div class:list={['pdf-flow', `pf-${b.board}`]} set:html={b.html} />;
  return null;
})}
