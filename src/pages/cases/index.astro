---
// Sections 04–05 openers (PDF pages 14 and 27) plus the case explorer.
import Base from '../../layouts/Base.astro';
import DocShell from '../../components/DocShell.astro';
import CaseExplorer from '../../components/CaseExplorer.astro';
import ov from '../../content/cases-overview.json';
import { makeGloss } from '../../lib/gloss.js';
import { u } from '../../lib/url.js';
import site from '../../data/site.json';

const g = makeGloss();
const regions = ov.map((r) => ({ ...r, introHtml: r.intro.map((p) => g.html(p)), id: `section-${r.number}` }));
const toc = [...regions.map((r) => ({ id: r.id, label: `${r.number} · ${r.title.replace('Case studies: ', '')}` })), { id: 'explore', label: 'Filter all cases' }];
---
<Base title="Case studies" description="Sections 04–05: nine African fintech and logistics cases in East, North and West Africa, plus Moove as a comparator, with their funding routes." current="cases/">
  <header class="sec-hero">
    <div class="wrap">
      <nav class="crumbs crumbs-light" aria-label="Breadcrumb"><a href={u()}>Home</a><span aria-hidden="true">/</span><span>Case studies</span></nav>
      <div class="sec-hero-grid">
        <div>
          <span class="pill">Sections 04–05</span>
          <p class="sec-num" aria-hidden="true">04–05</p>
          <h1>Case studies</h1>
        </div>
        {regions[0].art && <div class="sec-art-wrap" set:html={regions[0].art} />}
      </div>
    </div>
  </header>

  <DocShell toc={toc} here="cases/">
    {regions.map((r) => (
      <section aria-labelledby={r.id} class="region">
        <p class="lb">Section {r.number} · Geographies covered: {r.geographies}</p>
        <h2 id={r.id} class="sec-h">{r.title}</h2>
        {r.introHtml.map((p) => <p set:html={p} />)}
        <ol class="case-rows" role="list">
          {r.rows.map((row: any) => (
            <li class:list={{ cmp: row.comparator }}>
              <a href={u(`cases/${row.slug}/`)}>
                <span class="cr-n" aria-hidden="true">{row.comparator ? '+' : row.n}</span>
                <span class="cr-main"><b>{row.name}{row.comparator && <em> · Comparator</em>}</b><span>{row.sub}</span></span>
                <span class="chip" data-route={row.routeKey}><span class="sw" aria-hidden="true"></span>{row.route}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
    <section aria-labelledby="explore" class="region">
      <h2 id="explore" class="sec-h">Filter all cases</h2>
      <CaseExplorer />
    </section>
  </DocShell>
</Base>

<style>
  .region { margin-bottom: 56px; }
  .case-rows { list-style: none; margin: 22px 0 16px; padding: 0; border-top: 2px solid var(--ink); }
  .case-rows a { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 14px 4px; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: background-color .15s; }
  .case-rows a:hover { background: var(--violet-tint); }
  .cr-n { font: 800 2rem/1 var(--sans); background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cr-main b { display: block; font: 800 1.1875rem/1.25 var(--sans); }
  .cr-main b em { font-style: normal; font-weight: 700; font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--r-comparator); }
  .cr-main span { display: block; margin-top: 2px; font: 500 .875rem/1.4 var(--sans); color: var(--ink-soft); }
  .cmp a { border-bottom-style: dashed; }
  .cmp .cr-n { background: none; color: var(--r-comparator); }
  @media (max-width: 640px) { .case-rows a { grid-template-columns: 40px minmax(0, 1fr); } .case-rows .chip { grid-column: 2; justify-self: start; } }
</style>
